# Los scripts de shell se ejecutan con bash tambien en Windows: siempre LF.
*.sh text eol=lf
# Fuentes y manifiestos de Rust: siempre LF, para que fmt y los bytes del
# binario no dependan de core.autocrlf (F2-1).
*.rs text eol=lf
*.toml text eol=lf
Cargo.lock text eol=lf
# Esquema publicado de la configuracion (F2-7): se compara byte a byte con
# el que genera el codigo.
crates/tc2/esquemas/*.json text eol=lf
# Evidencia de mediciones (TASK-113): se compara por sha256 con el original.
docs/mediciones/** -text
